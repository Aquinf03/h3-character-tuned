# Fill these before disabling dry_run in recipe.yaml.
# Trainer defaults to this repo's src/ if H3_TRAINER_DIR is unset.
export H3_TRAINER_DIR=/path/to/h3-avatar-aq/src
export H3_MODEL_DIR=/path/to/MiniMax-H3
export TA20_ROOT=/path/to/TA2.0_animation_dataset

# Optional: override command names if your trainer uses a different launcher.
export H3_PREPARE_CMD=prepare_cache.py
export H3_TRAIN_CMD=train.py
